{
  "name": "smk-wayfinding",
  "version": "0.0.0",
  "private": true,
  "description": "Museum Wayfinding App for SMK (Statens Museum for Kunst)",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
