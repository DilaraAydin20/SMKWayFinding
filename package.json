{
  "name": "museum-wayfinding-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node --env-file=.env.local backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^10.0.7",
    "vite": "^5.0.0"
  }
}
